<?xml version="1.0" encoding="utf-8"?>
<ArrayOfOrganizerFilter xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <OrganizerFilter>
    <filter />
    <table>parts</table>
    <sorting />
    <name>Show all</name>
  </OrganizerFilter>
  <OrganizerFilter>
    <filter>
      <OrganizerFilterItem>
        <and>true</and>
        <id>material</id>
        <op>=</op>
        <value>IGEMS.MATERIAL</value>
      </OrganizerFilterItem>
      <OrganizerFilterItem>
        <and>true</and>
        <id>quality</id>
        <op>=</op>
        <value>IGEMS.QUALITY</value>
      </OrganizerFilterItem>
      <OrganizerFilterItem>
        <and>true</and>
        <id>thickness</id>
        <op>=</op>
        <value>IGEMS.THICKNESS</value>
      </OrganizerFilterItem>
      <OrganizerFilterItem>
        <and>true</and>
        <id>machinetype</id>
        <op>=</op>
        <value>IGEMS.MACHINETYPE</value>
      </OrganizerFilterItem>
      <OrganizerFilterItem>
        <and>true</and>
        <id>remains</id>
        <op>&gt;</op>
        <value>0</value>
      </OrganizerFilterItem>
      <OrganizerFilterItem>
        <and>true</and>
        <id>released</id>
        <op>=</op>
        <value>1</value>
      </OrganizerFilterItem>
    </filter>
    <table>parts</table>
    <sorting />
    <name>Insert</name>
  </OrganizerFilter>
</ArrayOfOrganizerFilter>