(SETQ dlg (GP-DIALOG "Beep demo"))
(GP-BUTTON dlg "Exclamation"    ACTION (LAMBDA(s) (BEEP T 0)))
(GP-BUTTON dlg "Asterisk"       ACTION (LAMBDA(s) (BEEP T 1)))
(GP-BUTTON dlg "Beep"           ACTION (LAMBDA(s) (BEEP T 2)))
(GP-BUTTON dlg "Hand"           ACTION (LAMBDA(s) (BEEP T 3)))
(GP-BUTTON dlg "Question"       ACTION (LAMBDA(s) (BEEP T 4)))


(GP-SHOWMODAL dlg)



























































































